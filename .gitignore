# ==== Jupyter ====
.ipynb_checkpoints/
*.ipynb_meta

# ==== Datasets ====
# Bases de dados baixadas automaticamente (ex.: CIFAR-10 via torchvision).
# A pasta é criada automaticamente pelo download; não precisa existir no git.
**/data/

# ==== Checkpoints e artefatos de treino (skill model-saver) ====
# results/{model_id}/ (pesos + metadata.json) É versionado de propósito — os
# modelos deste projeto são pequenos (MLP/CNN em CIFAR-10) e manter o
# histórico completo de execuções no git facilita comparar experimentos e
# entregar os resultados. As regras abaixo ainda ignoram checkpoints soltos
# fora de results/ (ex.: gerados por outras ferramentas).
*.pt
*.pth
*.ckpt
*.h5
*.keras
*.joblib
!**/results/**

# ==== Relatórios gerados ====
# **/reports/figures/*
!**/reports/figures/.gitkeep

# ==== SO / Editor ====
.DS_Store
Thumbs.db
.idea/
.vscode/

# ==== Outras pastas de trabalho ====
temp

# ==== Scripts geradores ====
# Os scripts que GERAM os notebooks (make_notebook.py, make_report_notebook.py)
# e o driver de execucao local. O artefato que importa e o notebook gerado,
# que ja e versionado em notebooks/.
**/scripts/
